{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --prefix portfolio-cms && rm -rf public/cms && cp -r portfolio-cms/dist public/cms && node fix_cms_paths.cjs && tsc && vite build && node scripts/generate-static-routes.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "analyze": "vite build --mode analyze",
    "audit:performance": "node scripts/performance-audit.mjs",
    "prebuild": "npm run optimize:images",
    "postbuild": "npm run audit:performance"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@portabletext/react": "^6.0.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@sanity/client": "^7.15.0",
    "@sanity/image-url": "^2.0.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-scroll": "^1.8.10",
    "@types/three": "^0.181.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.3",
    "gsap": "^3.14.2",
    "lenis": "^1.3.15",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.344.0",
    "motion": "^12.23.25",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.0",
    "react-scroll": "^1.9.3",
    "react-useanimations": "^2.10.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.58",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
